#pragma once

// ---------------------------------------------------------------------------
// Zugangsdaten. Diese Datei nach src/secrets.h kopieren und ausfuellen —
// secrets.h steht in .gitignore und darf nie eingecheckt werden.
//
// Bleiben die Felder leer, laeuft die Firmware trotzdem: WLAN und
// Transkription bleiben dann einfach aus, alles andere funktioniert.
// ---------------------------------------------------------------------------

#define WIFI_SSID      ""
#define WIFI_PASSWORD  ""

// https://platform.openai.com/api-keys
#define OPENAI_API_KEY ""

// gpt-4o-mini-transcribe kostet 0,003 USD je Minute und kann Teilergebnisse
// liefern, waehrend noch gesprochen wird. gpt-4o-transcribe ist genauer und
// doppelt so teuer.
#define STT_MODEL      "gpt-4o-mini-transcribe"
#define STT_LANGUAGE   "de"

// Modell fuer die Antwort. gpt-5.6-luna ist der guenstige Vertreter der
// aktuellen Reihe (0,20 USD je Million Zeichen hinein, 1,20 hinaus); fuer
// schwerere Fragen gibt es gpt-5.6-sol und gpt-6-astra. Fehlt die Zeile,
// nimmt die Firmware gpt-5.6-luna.
//
// gpt-4o-mini stand hier zuvor und antwortet noch, steht aber nicht mehr auf
// der Modellliste — dasselbe Muster, an dem die Realtime-Beta gescheitert
// ist. Ein Modell, das nicht mehr gelistet wird, faellt irgendwann aus.
#define CHAT_MODEL     "gpt-5.6-luna"

// Stimme fuer die gesprochene Antwort. Zur Auswahl stehen unter anderem
// alloy, ash, ballad, coral, echo, fable, nova, onyx, sage und shimmer.
// Fehlen die Zeilen, nimmt die Firmware gpt-4o-mini-tts mit alloy.
#define TTS_MODEL      "gpt-4o-mini-tts"
#define TTS_VOICE      "alloy"
